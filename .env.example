# ============================================================
# Firebase — Public client config (آمن يكون في الـ frontend)
# احصل عليها من: Firebase Console → Project Settings → Web App
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Feature flags — للتحكم في الميزات أثناء التطوير
# ============================================================
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_ANALYTICS=false

# ============================================================
# Legacy OAuth (للكود القديم فقط — سنستبدلها بـ Firebase Auth)
# ============================================================
# VITE_GOOGLE_CLIENT_ID=
# VITE_FACEBOOK_APP_ID=
# VITE_APPLE_CLIENT_ID=
